# Draft Ethan SNS Marketing Automation Environment Variables

# 1. Google Gemini 2.5 API Key
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Meta Graph API (Instagram & Threads)
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id
THREADS_USER_ID=your_threads_user_id
META_ACCESS_TOKEN=your_long_lived_meta_access_token

# 3. Supabase (Logging & Image Storage)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=marketing-cardnews

# 4. Marketing Settings
DRAFT_ETHAN_URL=https://draft-ethan.com
