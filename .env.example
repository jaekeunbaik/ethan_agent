# Draft Ethan SNS Marketing Automation Environment Variables

# 1. Google Gemini 2.5 API Key
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Meta Graph API (Instagram & Threads)
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id
INSTAGRAM_ACCESS_TOKEN=your_long_lived_instagram_page_or_user_access_token

THREADS_USER_ID=your_threads_user_id
THREADS_ACCESS_TOKEN=your_threads_developer_access_token

# 3. Marketing Settings
DRAFT_ETHAN_URL=https://draft-ethan.com
